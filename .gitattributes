# Keep hash-pinned text artwork byte-identical on Windows and Unix checkouts.
docs/assets/identity/*.svg text eol=lf

# Coverage manifests are byte-hashed at runtime; never convert them to CRLF.
gif_cinema/assets/fonts/*.coverage.json text eol=lf
gif_cinema/assets/fonts/OFL.txt text eol=lf
gif_cinema/assets/fonts/PROVENANCE.json text eol=lf

# Resource ZIPs must have the same bytes on Windows and Unix checkouts.
# The packaged license is byte-compared with this root source.
/LICENSE text eol=lf
.agents/skills/gif-cinema/** text=auto eol=lf
.agents/skills/gif-cinema/**/*.gif -text

# The offline factory example pins this scene's exact source bytes.
/examples/stroke-reveal.json text eol=lf
